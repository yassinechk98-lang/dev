# En-têtes de sécurité du site FreeAV (règle HDR-1 de securite.md).
# Le seul script en ligne est la ligne qui ajoute la classe « js » dans <head> ;
# il est autorisé par son empreinte. Si vous le modifiez, recalculez l'empreinte :
#   printf "%s" "document.documentElement.classList.add('js')" | openssl dgst -sha256 -binary | base64
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-Du+OJKJSbdUgz5nrHeWWINvez6XKDDU/tyj/5c2uvwo='; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cross-Origin-Opener-Policy: same-origin
